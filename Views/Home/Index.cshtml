
@model SelectList

<h1>
    @ViewData["text"]
</h1>

       <br/>
       <select name="sel" asp-items="@Model">

       </select>
       
      
        <form method="post">
            <fieldset>
               <!-- <legend class="display-5 fw-bold">Лабораторная работа 2</legend>-->
                <legend class="display-6 fw-bold">Список</legend>
                <ol type="A">
                    <li>Элемент 0 списка</li>
                    <li>Элемент 1 списка</li>
                    <li>Элемент 2 списка</li>
                    <li>Элемент 3 списка</li>
                    <li>Элемент 4 списка</li>
                </ol>

                <hr class="my-4 text-secondary">


                <legend class="display-6 fw-bold">Форма</legend>

                <div class="form-check offset-2">
                    <input class="form-check-input" type="checkbox" value="true" id="flexCheckDefault" name="chek-box1">
                    <label class="form-check-label" for="flexCheckDefault">
                        Чек-бокс 1
                    </label>
                </div>
                <div class="form-check offset-2">
                    <input class="form-check-input" type="checkbox" value="true" id="flexCheckChecked" checked name="chek-box2">
                    <label class="form-check-label" for="flexCheckChecked">
                        Чек-бокс 2
                    </label>
                </div>
             
                <div class="row mb-3"> </div>

                <fieldset class="col mb-3">
                    <legend class="col-form-label col-sm-2 pt-0">         </legend>


                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" id="inlineCheckbox1" value="option1" name="radio">
                    <label class="form-check-label" for="inlineCheckbox1">Радио-1</label>
                </div>
                <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="inlineCheckbox2" value="option2" name="radio">
                    <label class="form-check-label" for="inlineCheckbox2">Радио-2</label>
                </div>
                <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="inlineCheckbox3" value="option3" name="radio">
                    <label class="form-check-label" for="inlineCheckbox3">Радио-3 </label>
                </div>
                    </fieldset>

            <div class="row mb-3">
                <label for="inputLogin" class="col-sm-2 col-form-label">Логин</label>
                <div class="col-sm-10">
                        <input type="text" class="form-control" id="inputLogin" autocomplete="username" placeholder="Введите логин" name="login">
                </div>
            </div>


            <div class="row mb-3">
                <label for="inputPassword3" class="col-sm-2 col-form-label">Пароль</label>
                <div class="col-sm-10">
                        <input type="password" class="form-control" id="inputPassword3" autocomplete="password" placeholder="Введите пароль" name="password">
                </div>
            </div>
           
            
            <button type="submit" class="btn btn-primary">Отправить</button>
            </fieldset>
        </form>

      
      
        

        